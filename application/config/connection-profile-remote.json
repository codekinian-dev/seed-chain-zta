    "certificateAuthorities": {
        "ca-bpsbp": {
            "url": "https://168.144.141.220:7054",
            "httpOptions": {
                "verify": false
            },
            "tlsCACerts": {
                "path": "./tls-certs/ca/ca-bpsbp-tls.pem"
            },
            "caName": "ca-bpsbp"
        }
    }
