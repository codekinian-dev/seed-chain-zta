{
    "name": "bpsbp-network-fabric",
    "version": "1.0.0",
    "description": "Connection profile untuk aplikasi di server terpisah dari blockchain. Hanya membutuhkan TLS certificates, bukan seluruh crypto-config.",
    "client": {
        "organization": "BPSBP",
        "connection": {
            "timeout": {
                "peer": {
                    "endorser": "300"
                },
                "orderer": "300"
            }
        }
    },
    "channels": {
        "benihchannel": {
            "orderers": [
                "chain-orderer.jabarchain.me",
                "chain-orderer2.jabarchain.me",
                "chain-orderer3.jabarchain.me"
            ],
            "peers": {
                "pusat.chain-bpsbp.jabarchain.me": {
                    "endorsingPeer": true,
                    "chaincodeQuery": true,
                    "ledgerQuery": true,
                    "eventSource": true
                },
                "cert.chain-bpsbp.jabarchain.me": {
                    "endorsingPeer": true,
                    "chaincodeQuery": true,
                    "ledgerQuery": true,
                    "eventSource": true
                }
            }
        }
    },
    "organizations": {
        "BPSBP": {
            "mspid": "BPSBPBenihMSP",
            "peers": [
                "pusat.chain-bpsbp.jabarchain.me",
                "cert.chain-bpsbp.jabarchain.me"
            ],
            "certificateAuthorities": [
                "ca-bpsbp"
            ]
        }
    },
    "orderers": {
        "chain-orderer.jabarchain.me": {
            "url": "grpcs://168.144.141.220:7050",
            "grpcOptions": {
                "ssl-target-name-override": "chain-orderer.jabarchain.me",
                "grpc.max_send_message_length": 209715200,
                "grpc.max_receive_message_length": 209715200,
                "grpc.keepalive_time_ms": 360000,
                "grpc.keepalive_timeout_ms": 180000,
                "grpc.initial_reconnect_backoff_ms": 5000,
                "grpc.max_reconnect_backoff_ms": 30000,
                "request-timeout": 120000
            },
            "tlsCACerts": {
                "path": "./tls-certs/orderer/orderer-tls-ca.crt"
            }
        },
        "chain-orderer2.jabarchain.me": {
            "url": "grpcs://168.144.141.220:8050",
            "grpcOptions": {
                "ssl-target-name-override": "chain-orderer2.jabarchain.me",
                "grpc.max_send_message_length": 209715200,
                "grpc.max_receive_message_length": 209715200,
                "grpc.keepalive_time_ms": 360000,
                "grpc.keepalive_timeout_ms": 180000,
                "grpc.initial_reconnect_backoff_ms": 5000,
                "grpc.max_reconnect_backoff_ms": 30000,
                "request-timeout": 120000
            },
            "tlsCACerts": {
                "path": "./tls-certs/orderer/orderer2-tls-ca.crt"
            }
        },
        "chain-orderer3.jabarchain.me": {
            "url": "grpcs://168.144.141.220:9050",
            "grpcOptions": {
                "ssl-target-name-override": "chain-orderer3.jabarchain.me",
                "grpc.max_send_message_length": 209715200,
                "grpc.max_receive_message_length": 209715200,
                "grpc.keepalive_time_ms": 360000,
                "grpc.keepalive_timeout_ms": 180000,
                "grpc.initial_reconnect_backoff_ms": 5000,
                "grpc.max_reconnect_backoff_ms": 30000,
                "request-timeout": 120000
            },
            "tlsCACerts": {
                "path": "./tls-certs/orderer/orderer3-tls-ca.crt"
            }
        }
    },
    "peers": {
        "pusat.chain-bpsbp.jabarchain.me": {
            "url": "grpcs://168.144.141.220:7051",
            "grpcOptions": {
                "ssl-target-name-override": "pusat.chain-bpsbp.jabarchain.me",
                "grpc.keepalive_time_ms": 360000,
                "grpc.keepalive_timeout_ms": 180000,
                "grpc.http2.min_time_between_pings_ms": 120000,
                "grpc.initial_reconnect_backoff_ms": 5000,
                "grpc.max_reconnect_backoff_ms": 30000,
                "request-timeout": 120000
            },
            "tlsCACerts": {
                "path": "./tls-certs/peers/pusat-tls-ca.crt"
            }
        },
        "cert.chain-bpsbp.jabarchain.me": {
            "url": "grpcs://168.144.141.220:8051",
            "grpcOptions": {
                "ssl-target-name-override": "cert.chain-bpsbp.jabarchain.me",
                "grpc.keepalive_time_ms": 360000,
                "grpc.keepalive_timeout_ms": 180000,
                "grpc.http2.min_time_between_pings_ms": 120000,
                "grpc.initial_reconnect_backoff_ms": 5000,
                "grpc.max_reconnect_backoff_ms": 30000,
                "request-timeout": 120000
            },
            "tlsCACerts": {
                "path": "./tls-certs/peers/cert-tls-ca.crt"
            }
